# Copy to `.env`. Never commit real secrets.

SECRET_KEY=dev-only-change-me

# MockMSPaint runs on port 4321. Comma-separated if you add more origins.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Where Stripe sends the shopper after pay or cancel. MockMSPaint runs here.
FRONTEND_ORIGIN=http://localhost:4321

# Stripe Dashboard → Developers → API keys. Use the test secret key locally.
STRIPE_SECRET_KEY=sk_test_replace_me

# From `stripe listen --forward-to localhost:4000/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Staff password for POST /admin/login. Not a shopper account.
ADMIN_PASSWORD=replace-with-a-long-password

# Leave unset to use SQLite at instance/store.db.
# DATABASE_URL=sqlite:///instance/store.db
